rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── User profiles ──────────────────────────────────────────────────────────
    match /users/{userId} {
      // list: unauthenticated read needed for username-based login lookup
      // (query: where("username", "==", value) before the user is signed in)
      allow list: if true;
      allow get:  if true;

      // Only the owner may create / update / delete their profile document
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;

      // ── All user subcollections (subscription, billing, tasks, resumes,
      //    flashcardDecks, summaries, activityLog, studySessions, settings …)
      //    are private: only the owner can read or write them.
      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── Study planner — top-level collections keyed by userId field ────────────
    match /study_tasks/{taskId} {
      allow read:          if request.auth != null && resource.data.userId == request.auth.uid;
      allow create:        if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /study_schedule/{scheduleId} {
      allow read:          if request.auth != null && resource.data.userId == request.auth.uid;
      allow create:        if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // ── Legacy component collections keyed by userId field ────────────────────
    match /notes/{noteId} {
      allow read:          if request.auth != null && resource.data.userId == request.auth.uid;
      allow create:        if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /decks/{deckId} {
      allow read:          if request.auth != null && resource.data.userId == request.auth.uid;
      allow create:        if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
